---
import Base from "../layouts/Base.astro";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import RotuloSecao from "../components/ui/RotuloSecao.astro";
import hotel from "../content/hotel.json";
import quartos from "../content/quartos.json";
import { linkWhatsApp, MENSAGENS } from "../lib/whatsapp";

const title = `Reservar — ${hotel.nome}`;
const description = `Faça o pedido da sua reserva no ${hotel.nome} diretamente pelo site — escolha o quarto, as datas e envie pra nossa equipe confirmar pelo WhatsApp.`;

const campoClasses =
  "border-b border-linho bg-transparent py-2.5 text-carvao outline-none placeholder:text-verdeCl focus:border-verde";
const rotuloClasses = "text-[11px] uppercase tracking-nav text-verdeCl";
---

<Base title={title} description={description}>
  <Header />
  <main id="conteudo-principal">
    <section class="secao container-page max-w-2xl">
      <RotuloSecao texto="Reserva" />
      <h1 class="text-carvao">Peça sua reserva.</h1>
      <p class="mt-4 text-verdeCl">Escolha o quarto e as datas, conte um pouco sobre a sua estadia e envie — sua equipe recebe o pedido organizado e confirma com você pelo WhatsApp. Prefere falar direto? <a href={linkWhatsApp(MENSAGENS.hero)} target="_blank" rel="noopener noreferrer" class="text-verde underline decoration-cobre underline-offset-4 hover:text-verdeEsc">Chame no WhatsApp</a>.</p>

      <form id="form-reserva" class="mt-10 flex flex-col gap-6" novalidate>
        <div class="flex flex-col gap-2">
          <span id="quarto-label" class={rotuloClasses}>Quarto</span>
          <div class="relative">
            <button
              type="button"
              id="quarto-trigger"
              aria-haspopup="listbox"
              aria-expanded="false"
              aria-controls="quarto-listbox"
              aria-labelledby="quarto-label quarto-trigger"
              class={`${campoClasses} flex w-full items-center justify-between text-left`}
            >
              <span id="quarto-trigger-texto" class="text-verdeCl">Selecione o quarto</span>
              <svg
                id="quarto-seta"
                width="14"
                height="14"
                viewBox="0 0 24 24"
                fill="none"
                aria-hidden="true"
                class="shrink-0 text-verdeCl transition-transform duration-200"
              >
                <path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="1.5" />
              </svg>
            </button>

            <ul
              id="quarto-listbox"
              role="listbox"
              aria-labelledby="quarto-label"
              tabindex="-1"
              hidden
              class="absolute z-20 mt-1 max-h-60 w-full overflow-auto border border-linho bg-osso shadow-lg"
            >
              {
                quartos.map((q) => (
                  <li
                    role="option"
                    id={`opcao-${q.slug}`}
                    data-value={q.nome}
                    aria-selected="false"
                    class="cursor-pointer px-4 py-3 text-sm text-carvao transition-colors hover:bg-linho aria-selected:bg-linho aria-selected:font-medium"
                  >
                    {q.nome}
                  </li>
                ))
              }
            </ul>

            <input type="hidden" id="quarto" name="quarto" />
          </div>
        </div>

        <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
          <div class="flex flex-col gap-2">
            <label for="checkin" class={rotuloClasses}>Check-in</label>
            <input id="checkin" name="checkin" type="date" required class={campoClasses} />
          </div>
          <div class="flex flex-col gap-2">
            <label for="checkout" class={rotuloClasses}>Check-out</label>
            <input id="checkout" name="checkout" type="date" required class={campoClasses} />
          </div>
        </div>

        <div class="flex flex-col gap-2 sm:w-1/2 sm:pr-3">
          <label for="hospedes" class={rotuloClasses}>Hóspedes</label>
          <input
            id="hospedes"
            name="hospedes"
            type="number"
            min="1"
            value="2"
            required
            class={campoClasses}
          />
        </div>

        <div class="flex flex-col gap-2">
          <label for="nome" class={rotuloClasses}>Nome</label>
          <input id="nome" name="nome" type="text" required class={campoClasses} placeholder="Seu nome" />
        </div>

        <div class="flex flex-col gap-2">
          <label for="telefone" class={rotuloClasses}>Telefone</label>
          <input
            id="telefone"
            name="telefone"
            type="tel"
            required
            class={campoClasses}
            placeholder="(38) 9 9999-9999"
          />
        </div>

        <div class="flex flex-col gap-2">
          <label for="email" class={rotuloClasses}>E-mail (opcional)</label>
          <input id="email" name="email" type="email" class={campoClasses} placeholder="seu@email.com" />
        </div>

        <button
          type="submit"
          class="mt-2 inline-flex items-center justify-center gap-2 self-start bg-verde px-9 py-4 text-xs font-medium uppercase tracking-nav text-osso transition-colors duration-[250ms] hover:bg-verdeEsc"
        >
          Enviar pedido de reserva
        </button>
      </form>
    </section>
  </main>
  <Footer />
</Base>

<script>
  import { linkWhatsApp, mensagemReserva } from "../lib/whatsapp";

  const form = document.getElementById("form-reserva") as HTMLFormElement | null;
  const checkin = document.getElementById("checkin") as HTMLInputElement | null;
  const checkout = document.getElementById("checkout") as HTMLInputElement | null;

  const hoje = new Date().toISOString().split("T")[0];

  // Dropdown customizado do quarto (role="listbox" + aria-activedescendant)
  const quartoTrigger = document.getElementById("quarto-trigger") as HTMLButtonElement | null;
  const quartoTriggerTexto = document.getElementById("quarto-trigger-texto");
  const quartoListbox = document.getElementById("quarto-listbox") as HTMLUListElement | null;
  const quartoInput = document.getElementById("quarto") as HTMLInputElement | null;
  const quartoSeta = document.getElementById("quarto-seta");
  const opcoesQuarto = quartoListbox
    ? Array.from(quartoListbox.querySelectorAll<HTMLLIElement>('[role="option"]'))
    : [];

  let indiceAtivo = -1;

  function focarOpcao(indice: number) {
    if (!quartoTrigger || !opcoesQuarto[indice]) return;
    indiceAtivo = indice;
    opcoesQuarto.forEach((o, i) => o.classList.toggle("bg-linho", i === indice));
    quartoTrigger.setAttribute("aria-activedescendant", opcoesQuarto[indice].id);
    opcoesQuarto[indice].scrollIntoView({ block: "nearest" });
  }

  function selecionarOpcao(indice: number) {
    const opcao = opcoesQuarto[indice];
    if (!opcao || !quartoInput || !quartoTriggerTexto) return;
    opcoesQuarto.forEach((o, i) => o.setAttribute("aria-selected", String(i === indice)));
    const valor = opcao.dataset.value ?? "";
    quartoInput.value = valor;
    quartoTriggerTexto.textContent = valor;
    quartoTriggerTexto.classList.remove("text-verdeCl");
    quartoTriggerTexto.classList.add("text-carvao");
  }

  function abrirListbox() {
    if (!quartoListbox || !quartoTrigger) return;
    quartoListbox.hidden = false;
    quartoTrigger.setAttribute("aria-expanded", "true");
    quartoSeta?.classList.add("rotate-180");
    const indiceSelecionado = opcoesQuarto.findIndex(
      (o) => o.getAttribute("aria-selected") === "true"
    );
    focarOpcao(indiceSelecionado >= 0 ? indiceSelecionado : 0);
  }

  function fecharListbox(opcoes: { focarTrigger?: boolean } = {}) {
    if (!quartoListbox || !quartoTrigger) return;
    quartoListbox.hidden = true;
    quartoTrigger.setAttribute("aria-expanded", "false");
    quartoTrigger.removeAttribute("aria-activedescendant");
    quartoSeta?.classList.remove("rotate-180");
    indiceAtivo = -1;
    if (opcoes.focarTrigger !== false) quartoTrigger.focus();
  }

  quartoTrigger?.addEventListener("click", () => {
    const aberto = quartoTrigger.getAttribute("aria-expanded") === "true";
    if (aberto) fecharListbox();
    else abrirListbox();
  });

  quartoTrigger?.addEventListener("keydown", (e) => {
    const aberto = quartoTrigger.getAttribute("aria-expanded") === "true";

    if (!aberto) {
      if (["ArrowDown", "ArrowUp", "Enter", " "].includes(e.key)) {
        e.preventDefault();
        abrirListbox();
      }
      return;
    }

    switch (e.key) {
      case "ArrowDown":
        e.preventDefault();
        focarOpcao(Math.min(indiceAtivo + 1, opcoesQuarto.length - 1));
        break;
      case "ArrowUp":
        e.preventDefault();
        focarOpcao(Math.max(indiceAtivo - 1, 0));
        break;
      case "Home":
        e.preventDefault();
        focarOpcao(0);
        break;
      case "End":
        e.preventDefault();
        focarOpcao(opcoesQuarto.length - 1);
        break;
      case "Enter":
      case " ":
        e.preventDefault();
        if (indiceAtivo >= 0) {
          selecionarOpcao(indiceAtivo);
          fecharListbox();
        }
        break;
      case "Escape":
        e.preventDefault();
        fecharListbox();
        break;
      case "Tab":
        fecharListbox({ focarTrigger: false });
        break;
    }
  });

  opcoesQuarto.forEach((opcao, indice) => {
    opcao.addEventListener("click", () => {
      selecionarOpcao(indice);
      fecharListbox();
    });
    opcao.addEventListener("mouseenter", () => focarOpcao(indice));
  });

  document.addEventListener("click", (e) => {
    if (!quartoListbox || quartoListbox.hidden || !quartoTrigger) return;
    const alvo = e.target as Node;
    if (!quartoTrigger.contains(alvo) && !quartoListbox.contains(alvo)) {
      fecharListbox({ focarTrigger: false });
    }
  });

  if (checkin && checkout) {
    checkin.min = hoje;
    checkout.min = hoje;

    checkin.addEventListener("change", () => {
      if (!checkin.value) return;
      const proximoDia = new Date(checkin.value);
      proximoDia.setDate(proximoDia.getDate() + 1);
      const minCheckout = proximoDia.toISOString().split("T")[0];
      checkout.min = minCheckout;
      if (checkout.value && checkout.value <= checkin.value) {
        checkout.value = minCheckout;
      }
    });
  }

  // Pré-seleciona o quarto se a página foi aberta com ?quarto=nome-do-quarto
  const quartoParam = new URLSearchParams(window.location.search).get("quarto");
  if (quartoParam) {
    const indice = opcoesQuarto.findIndex(
      (o) => (o.dataset.value ?? "").toLowerCase() === quartoParam.toLowerCase()
    );
    if (indice >= 0) selecionarOpcao(indice);
  }

  form?.addEventListener("submit", (e) => {
    e.preventDefault();

    if (!quartoInput?.value) {
      abrirListbox();
      return;
    }

    if (checkin && checkout && checkout.value <= checkin.value) {
      checkout.setCustomValidity("A data de check-out precisa ser depois do check-in.");
    } else {
      checkout?.setCustomValidity("");
    }

    if (!form.checkValidity()) {
      form.reportValidity();
      return;
    }

    const dados = new FormData(form);
    const texto = mensagemReserva({
      quarto: String(dados.get("quarto")),
      checkin: String(dados.get("checkin")),
      checkout: String(dados.get("checkout")),
      hospedes: String(dados.get("hospedes")),
      nome: String(dados.get("nome")),
      telefone: String(dados.get("telefone")),
      email: dados.get("email") ? String(dados.get("email")) : undefined,
    });

    window.open(linkWhatsApp(texto), "_blank", "noopener,noreferrer");
  });
</script>
