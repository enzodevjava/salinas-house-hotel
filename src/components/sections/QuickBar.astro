---
import estrutura from "../../content/estrutura.json";

const ordem = ["cafe-da-manha", "wifi", "estacionamento", "recepcao-24h", "pet-friendly"];

const itens = ordem
  .map((slug) => estrutura.find((item) => item.slug === slug))
  .filter((item) => item !== undefined);

const icones: Record<string, string> = {
  "cafe-da-manha":
    'M4 3v4M8 3v4M4 10h11a2 2 0 0 1 2 2v1a5 5 0 0 1-5 5H9a5 5 0 0 1-5-5v-3Zm13 3h1.5a2 2 0 0 1 0 4H17',
  wifi: "M2 8.5a15 15 0 0 1 20 0M5.5 12a10 10 0 0 1 13 0M9 15.5a5 5 0 0 1 6 0M12 19h.01",
  estacionamento:
    "M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18ZM9.5 16V8h3.2a2.3 2.3 0 0 1 0 4.6H9.5",
  "recepcao-24h": "M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18Zm0-14v5l3.5 2",
  "pet-friendly":
    "M7 10a2 2 0 1 0 0-4 2 2 0 0 0 0 4Zm10 0a2 2 0 1 0 0-4 2 2 0 0 0 0 4ZM4.5 15a2 2 0 1 0 0-4 2 2 0 0 0 0 4Zm15 0a2 2 0 1 0 0-4 2 2 0 0 0 0 4ZM12 20c-3 0-5.5-1.6-5.5-4 0-1.9 2.2-3.5 5.5-3.5s5.5 1.6 5.5 3.5c0 2.4-2.5 4-5.5 4Z",
};
---

<div class="bg-linho">
  <div
    class="container-page flex gap-x-10 gap-y-3 overflow-x-auto scroll-sem-barra py-5 sm:justify-between"
  >
    {
      itens.map((item) => (
        <div class="flex shrink-0 items-center gap-2.5 text-[11px] font-medium uppercase tracking-nav text-verde">
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            aria-hidden="true"
            class="shrink-0 text-verdeCl"
          >
            <path
              d={icones[item!.slug]}
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
          <span>{item!.nome}</span>
        </div>
      ))
    }
  </div>
</div>
