---
import estrutura from "../../content/estrutura.json";
import RotuloSecao from "../ui/RotuloSecao.astro";
import Reveal from "../ui/Reveal.astro";

const QTD_VISIVEL_MOBILE = 6;
const visiveis = estrutura.slice(0, QTD_VISIVEL_MOBILE);
const extras = estrutura.slice(QTD_VISIVEL_MOBILE);
---

<section id="estrutura" class="secao bg-linho">
  <div class="container-page">
    <Reveal>
      <RotuloSecao texto="Estrutura" />
      <h2 class="text-carvao">Tudo o que você precisa por perto.</h2>
    </Reveal>

    <div class="mt-14 grid grid-cols-1 gap-x-10 gap-y-12 sm:grid-cols-2 lg:grid-cols-3">
      {
        visiveis.map((item, i) => (
          <Reveal indice={i % 3}>
            <span class="font-display text-lg text-cobreTexto">{item.numero}</span>
            <h3 class="mt-3 text-xl text-carvao">{item.nome}</h3>
            <p class="mt-2 text-sm text-verdeCl">{item.descricao}</p>
          </Reveal>
        ))
      }
      <div class="estrutura-extras-wrapper" data-visivel="false">
        <div class="estrutura-extras-interior">
          {
            extras.map((item, i) => (
              <Reveal indice={i % 3}>
                <span class="font-display text-lg text-cobreTexto">{item.numero}</span>
                <h3 class="mt-3 text-xl text-carvao">{item.nome}</h3>
                <p class="mt-2 text-sm text-verdeCl">{item.descricao}</p>
              </Reveal>
            ))
          }
        </div>
      </div>
    </div>

    {
      extras.length > 0 && (
        <button
          type="button"
          id="estrutura-ver-mais"
          aria-expanded="false"
          class="group mt-10 inline-flex items-center gap-2 text-xs font-medium uppercase tracking-nav text-verde transition-colors duration-200 hover:text-verdeEsc sm:hidden"
        >
          <span id="estrutura-ver-mais-texto">Ver mais comodidades</span>
          <svg
            id="estrutura-ver-mais-seta"
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            aria-hidden="true"
            class="shrink-0 transition-transform duration-200 group-hover:translate-y-0.5"
          >
            <path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="1.5" />
          </svg>
        </button>
      )
    }
  </div>
</section>

<style>
  .estrutura-extras-wrapper {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 450ms var(--ease-reveal, ease-out);
  }
  .estrutura-extras-interior {
    overflow: hidden;
    display: flex;
    flex-direction: column;
    gap: 3rem;
    opacity: 0;
    transition: opacity 300ms ease-out;
  }
  .estrutura-extras-wrapper[data-visivel="true"] {
    grid-template-rows: 1fr;
  }
  .estrutura-extras-wrapper[data-visivel="true"] .estrutura-extras-interior {
    opacity: 1;
    transition-delay: 150ms;
  }
  @media (min-width: 640px) {
    .estrutura-extras-wrapper,
    .estrutura-extras-interior {
      display: contents;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .estrutura-extras-wrapper,
    .estrutura-extras-interior {
      transition: none;
    }
  }
</style>

<script>
  const botao = document.getElementById("estrutura-ver-mais");
  const texto = document.getElementById("estrutura-ver-mais-texto");
  const seta = document.getElementById("estrutura-ver-mais-seta");
  const wrapper = document.querySelector<HTMLElement>(".estrutura-extras-wrapper");

  botao?.addEventListener("click", () => {
    const aberto = botao.getAttribute("aria-expanded") === "true";
    botao.setAttribute("aria-expanded", String(!aberto));
    if (wrapper) wrapper.dataset.visivel = String(!aberto);
    if (texto) texto.textContent = aberto ? "Ver mais comodidades" : "Ver menos";
    seta?.classList.toggle("rotate-180", !aberto);
  });
</script>
