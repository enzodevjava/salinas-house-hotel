---
import { Picture } from "astro:assets";
import type { ImageMetadata } from "astro";
import salinas from "../../content/salinas.json";
import hotel from "../../content/hotel.json";
import RotuloSecao from "../ui/RotuloSecao.astro";
import Reveal from "../ui/Reveal.astro";
import Botao from "../ui/Botao.astro";
import MapaLazy from "../ui/MapaLazy.astro";
import { linkWhatsApp, MENSAGENS } from "../../lib/whatsapp";

const arquivosImagem = import.meta.glob<{ default: ImageMetadata }>(
  "../../assets/images/salinas/*.{jpg,jpeg,png}",
  { eager: true }
);

const encontrarImagem = (arquivo: string): ImageMetadata => {
  const entrada = Object.entries(arquivosImagem).find(([caminho]) =>
    caminho.endsWith(`/${arquivo}`)
  );
  if (!entrada) throw new Error(`Imagem não encontrada: ${arquivo}`);
  return entrada[1].default;
};
---

<section id="salinas" class="secao bg-verdeEsc text-osso">
  <div class="container-page">
    <Reveal>
      <RotuloSecao texto="A Região" claro />
      <h2 class="text-osso">A Cidade Mundial da Cachaça.</h2>
      <p class="mt-4 max-w-2xl text-osso/75">{salinas.intro}</p>
    </Reveal>

    <div class="mt-14 grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-4">
      {
        salinas.atracoes.map((atracao, i) => (
          <Reveal indice={i % 4} class="border border-linho bg-osso">
            <Picture
              src={encontrarImagem(atracao.imagem)}
              alt={atracao.alt}
              formats={["avif", "webp"]}
              widths={[320, 640]}
              sizes="(min-width: 1024px) 25vw, (min-width: 640px) 50vw, 100vw"
              loading={i === 0 ? "eager" : "lazy"}
              fetchpriority={i === 0 ? "high" : "auto"}
              class="aspect-[4/3] w-full object-cover"
            />
            <div class="p-5">
              <h3 class="text-lg text-carvao">{atracao.nome}</h3>
              <p class="mt-2 text-sm text-verdeCl">{atracao.texto}</p>
              {atracao.distancia && (
                <p class="mt-3 text-[11px] uppercase tracking-nav text-cobreTexto">
                  {atracao.distancia}
                </p>
              )}
            </div>
          </Reveal>
        ))
      }
    </div>

    <Reveal indice={1} class="mt-10">
      <Botao href={linkWhatsApp(MENSAGENS.salinas)} target="_blank">
        Planeje sua visita
      </Botao>
    </Reveal>

    <Reveal indice={2} class="mt-14">
      <MapaLazy embedUrl={hotel.mapaEmbedUrl} titulo={`Mapa de localização do ${hotel.nome}`} />
    </Reveal>
  </div>
</section>
