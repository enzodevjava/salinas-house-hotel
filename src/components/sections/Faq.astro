---
import faq from "../../content/faq.json";
import RotuloSecao from "../ui/RotuloSecao.astro";
import Reveal from "../ui/Reveal.astro";
---

<section id="faq" class="secao container-page pt-12 sm:pt-16">
  <Reveal class="mx-auto max-w-2xl text-center">
    <RotuloSecao texto="Perguntas Frequentes" />
    <h2 class="text-carvao">Tire suas dúvidas.</h2>
  </Reveal>

  <Reveal class="mx-auto mt-10 max-w-2xl" as="div">
    <details class="group/faq">
      <summary class="mx-auto flex w-fit cursor-pointer list-none items-center justify-center gap-2 bg-verde px-9 py-4 text-xs font-medium uppercase tracking-nav text-osso transition-colors duration-[250ms] marker:content-none hover:bg-osso hover:text-verdeEsc">
        <span>Ver perguntas frequentes</span>
        <svg
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          aria-hidden="true"
          class="shrink-0 transition-transform duration-200 group-open/faq:rotate-45"
        >
          <path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="1.5" />
        </svg>
      </summary>

      <div class="mt-8">
        {
          faq.map((item) => (
            <details class="group border-b border-linho py-5">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-carvao marker:content-none">
                <span class="font-display text-lg">{item.pergunta}</span>
                <svg
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="none"
                  aria-hidden="true"
                  class="shrink-0 text-verdeCl transition-transform duration-200 group-open:rotate-45"
                >
                  <path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="1.5" />
                </svg>
              </summary>
              <p class="mt-3 text-verdeCl">{item.resposta}</p>
            </details>
          ))
        }
      </div>
    </details>
  </Reveal>
</section>
