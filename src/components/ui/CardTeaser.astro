---
import { Picture } from "astro:assets";
import type { ImageMetadata } from "astro";
import RotuloSecao from "./RotuloSecao.astro";

interface Props {
  imagem: ImageMetadata;
  alt: string;
  rotulo: string;
  titulo: string;
  texto: string;
  href: string;
}

const { imagem, alt, rotulo, titulo, texto, href } = Astro.props;
---

<a
  href={href}
  class="group flex h-full flex-col border border-linho bg-osso transition-colors hover:border-verdeCl"
>
  <div class="relative aspect-[4/3] w-full overflow-hidden">
    <Picture
      src={imagem}
      alt={alt}
      formats={["avif", "webp"]}
      widths={[400, 700]}
      sizes="(min-width: 1024px) 25vw, (min-width: 640px) 50vw, 100vw"
      loading="lazy"
      class="absolute inset-0 h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
    />
  </div>
  <div class="flex flex-1 flex-col p-6">
    <RotuloSecao texto={rotulo} />
    <h3 class="text-carvao">{titulo}</h3>
    <p class="mt-3 flex-1 text-sm text-verdeCl">{texto}</p>
    <span
      class="mt-5 inline-flex items-center gap-2 text-[11px] font-medium uppercase tracking-nav text-verde"
    >
      Ver mais
      <svg
        width="14"
        height="14"
        viewBox="0 0 24 24"
        fill="none"
        aria-hidden="true"
        class="transition-transform group-hover:translate-x-1"
      >
        <path d="M5 12h14m-6-6 6 6-6 6" stroke="currentColor" stroke-width="1.5" />
      </svg>
    </span>
  </div>
</a>
