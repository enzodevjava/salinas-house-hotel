---
import { linkWhatsApp, MENSAGENS } from "../../lib/whatsapp";

const href = linkWhatsApp(MENSAGENS.flutuante);
---

<a
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Falar no WhatsApp"
  id="whatsapp-flutuante"
  class="fixed bottom-3 right-3 z-40 flex h-12 w-12 items-center justify-center rounded-full bg-verde text-osso opacity-0 pointer-events-none shadow-lg transition-all duration-300 ease-out hover:scale-110 hover:bg-[#25D366] hover:shadow-xl data-[visivel=true]:opacity-100 data-[visivel=true]:pointer-events-auto sm:bottom-4 sm:right-4 sm:h-14 sm:w-14"
  data-visivel="false"
>
  <svg
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 24 24"
    width="26"
    height="26"
    fill="currentColor"
    aria-hidden="true"
  >
    <path
      d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.33 4.95L2.05 22l5.25-1.38a9.9 9.9 0 0 0 4.74 1.21h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.86 9.86 0 0 0 12.04 2Zm0 1.67c2.19 0 4.25.85 5.8 2.4a8.2 8.2 0 0 1 2.4 5.84c0 4.53-3.68 8.24-8.21 8.24a8.2 8.2 0 0 1-4.18-1.14l-.3-.18-3.12.82.83-3.04-.2-.31a8.18 8.18 0 0 1-1.26-4.39c0-4.53 3.69-8.24 8.24-8.24Zm-4.5 4.19c-.16 0-.42.06-.64.3-.22.24-.85.83-.85 2.02s.87 2.35.99 2.51c.12.16 1.7 2.69 4.19 3.66 2.07.82 2.49.65 2.94.61.45-.04 1.44-.59 1.64-1.16.2-.57.2-1.05.14-1.16-.06-.1-.22-.16-.46-.28-.24-.12-1.44-.71-1.66-.79-.22-.08-.39-.12-.55.12-.16.24-.63.79-.78.95-.14.16-.28.18-.52.06-.24-.12-1.02-.38-1.94-1.2-.72-.64-1.2-1.43-1.34-1.67-.14-.24-.02-.37.11-.49.11-.11.24-.28.36-.42.12-.14.16-.24.24-.4.08-.16.04-.3-.02-.42-.06-.12-.55-1.35-.76-1.84-.2-.48-.4-.42-.55-.42Z"
    ></path>
  </svg>
</a>

<script>
  const botao = document.getElementById("whatsapp-flutuante");

  if (botao) {
    const atualizar = () => {
      botao.dataset.visivel = window.scrollY > 400 ? "true" : "false";
    };

    atualizar();
    window.addEventListener("scroll", atualizar, { passive: true });
  }
</script>
